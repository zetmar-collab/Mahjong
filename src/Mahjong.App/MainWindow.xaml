<Window x:Class="Mahjong.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mahjong Solitaire" Icon="pack://application:,,,/Assets/mahjong.ico" Width="1440" Height="900" MinWidth="1000" MinHeight="680" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid Margin="28,14,28,16">
  <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="{DynamicResource Accent}" CornerRadius="9" Width="38" Height="43" Margin="0,0,13,0"><TextBlock Text="M" FontFamily="Georgia" Foreground="#18372E" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="MAHJONG" FontFamily="Georgia" FontSize="24" VerticalAlignment="Center"/><TextBlock Text=" / SOLITAIRE" FontSize="10" Foreground="{DynamicResource Muted}" Margin="10,7,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
    <Button x:Name="LanguageButton" Content="Polski / English" Click="Language_Click"/>
    <Button x:Name="SettingsButton" Click="Settings_Click"/>
    <Button x:Name="FullscreenButton" Content="⛶" Click="Fullscreen_Click" FontSize="20"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="ContentArea" Grid.Row="1" Margin="0,12,0,0"/>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <TextBlock x:Name="Footer" FontSize="11" Foreground="{DynamicResource Muted}"/>
   <TextBlock Text="H · Esc · F11" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
  </Grid>
 </Grid>
</Window>
