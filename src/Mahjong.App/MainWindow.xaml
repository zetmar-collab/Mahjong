<Window x:Class="Mahjong.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mahjong Solitaire" Icon="pack://application:,,,/Assets/mahjong.ico" Width="1440" Height="900" MinWidth="1000" MinHeight="680" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid Margin="28,16,28,16">
  <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Assets/mahjong-icon.png" Width="36" Height="42" Margin="0,0,14,0"/>
    <TextBlock Text="MAHJONG" FontFamily="Georgia" FontSize="24" VerticalAlignment="Center"/><TextBlock Text=" / SOLITAIRE" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,7,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
    <Button x:Name="LanguageButton" Content="Polski / English" Click="Language_Click"/>
    <Button x:Name="SettingsButton" Click="Settings_Click"/>
    <Button x:Name="FullscreenButton" Click="Fullscreen_Click" ToolTip="F11"><Path Width="16" Height="16" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Data="M0,6 L0,0 6,0 M10,0 L16,0 16,6 M16,10 L16,16 10,16 M6,16 L0,16 0,10"/></Button>
   </StackPanel>
  </Grid>
  <Grid x:Name="ContentArea" Grid.Row="1" Margin="0,12,0,0"/>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <TextBlock x:Name="Footer" FontSize="12" Foreground="{DynamicResource Muted}"/>
   <TextBlock Text="H · Esc · F11" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
  </Grid>
 </Grid>
</Window>
